# Phase 8 — Continuous Training
# Copy this file to .env and adjust values for your environment

# Path to the folder containing churn_train_v1.parquet, churn_val_v1.parquet, churn_test_v1.parquet
# Also where simulate_new_data.py writes its backups/ subfolder
DATA_DIR=data/processed

# MLflow tracking server URI — must be running before main_flow.py is executed
MLFLOW_TRACKING_URI=http://localhost:5000

# Where retrain_manager.py stores the live/previous model version registry
VERSION_REGISTRY_PATH=registry/version_registry.json
