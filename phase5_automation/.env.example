# Phase 5 — Pipeline Automation
# Copy this file to .env and adjust values for your environment

# Path to the folder containing churn_train_v1.parquet, churn_val_v1.parquet, churn_test_v1.parquet
# Defaults to "data/processed" (relative to where main_flow.py is run) if not set
DATA_DIR=data/processed

# MLflow tracking server URI
# Must be running before main_flow.py is executed
MLFLOW_TRACKING_URI=http://localhost:5000
